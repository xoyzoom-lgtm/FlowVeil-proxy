<UserControl
    x:Class="v2rayN.Views.HuppUpdateView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    Width="400">
    <StackPanel Margin="28">
        <TextBlock
            FontSize="20"
            FontWeight="Bold"
            Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"
            Text="Обновление FlowVeil" />
        <TextBlock
            x:Name="txtStatus"
            Margin="0,12,0,0"
            FontSize="14"
            Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"
            Text="Проверяю…"
            TextWrapping="Wrap" />
        <TextBlock
            x:Name="txtVersion"
            Margin="0,4,0,0"
            FontSize="12"
            Foreground="{DynamicResource MaterialDesign.Brush.ForegroundLight}" />
        <ProgressBar
            x:Name="progress"
            Height="6"
            Margin="0,16,0,0"
            materialDesign:TransitionAssist.DisableTransitions="True"
            IsIndeterminate="True" />
        <StackPanel
            Margin="0,24,0,0"
            HorizontalAlignment="Right"
            Orientation="Horizontal">
            <Button
                x:Name="btnClose"
                Margin="0,0,8,0"
                materialDesign:ButtonAssist.CornerRadius="18"
                Content="Закрыть"
                IsCancel="True"
                Style="{StaticResource MaterialDesignFlatButton}" />
            <Button
                x:Name="btnInstall"
                Height="36"
                Padding="20,0"
                materialDesign:ButtonAssist.CornerRadius="18"
                Content="Скачать и установить"
                Visibility="Collapsed" />
        </StackPanel>
    </StackPanel>
</UserControl>
