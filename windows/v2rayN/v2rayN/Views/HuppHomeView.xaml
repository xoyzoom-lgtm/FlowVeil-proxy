<UserControl
    x:Class="v2rayN.Views.HuppHomeView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:common="clr-namespace:v2rayN.Common"
    xmlns:conv="clr-namespace:v2rayN.Converters"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    Background="{DynamicResource FV.Brush.Window}"
    FontFamily="{StaticResource FV.Font.Ui}">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <conv:NotEmptyToVisibilityConverter x:Key="NotEmptyToVis" />
        <conv:ProfileNameConverter x:Key="ProfileName" />
        <conv:ProfileCodeConverter x:Key="ProfileCode" />
        <conv:ProfileChipsConverter x:Key="ProfileChips" />
        <conv:FlagImageConverter x:Key="FlagImage" />
        <conv:PingStateConverter x:Key="PingState" />
        <conv:PingTextConverter x:Key="PingText" />
        <conv:DisplayTextConverter x:Key="DisplayText" />

        <!--  Thin scrollbars on this screen  -->
        <Style BasedOn="{StaticResource FV.ScrollBar}" TargetType="ScrollBar" />

        <!--  Flag picture; a neutral globe when the server has no flag  -->
        <DataTemplate x:Key="Flag">
            <Grid Width="32" Height="24">
                <Border Background="{DynamicResource FV.Brush.Surface2}" CornerRadius="6" />
                <materialDesign:PackIcon
                    x:Name="globe"
                    Width="16"
                    Height="16"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Foreground="{DynamicResource FV.Brush.Text3}"
                    Kind="Earth"
                    Visibility="Collapsed" />
                <Border CornerRadius="6">
                    <Border.Background>
                        <ImageBrush ImageSource="{Binding Converter={StaticResource FlagImage}}" Stretch="UniformToFill" />
                    </Border.Background>
                </Border>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding}" Value="">
                    <Setter TargetName="globe" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding}" Value="{x:Null}">
                    <Setter TargetName="globe" Property="Visibility" Value="Visible" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!--  Ping pill, fixed width; the DataContext is the DelayVal string  -->
        <DataTemplate x:Key="PingPill">
            <Border
                x:Name="pill"
                Width="68"
                Height="24"
                Background="{DynamicResource FV.Brush.Surface2}"
                CornerRadius="12">
                <Grid>
                    <TextBlock
                        x:Name="txt"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource FV.Brush.Text3}"
                        Text="{Binding Converter={StaticResource PingText}}" />
                    <ProgressBar
                        x:Name="spin"
                        Width="14"
                        Height="14"
                        Foreground="{DynamicResource FV.Brush.Accent}"
                        IsIndeterminate="False"
                        Style="{StaticResource MaterialDesignCircularProgressBar}"
                        Visibility="Collapsed"
                        Value="0" />
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Converter={StaticResource PingState}}" Value="ok">
                    <Setter TargetName="pill" Property="Background" Value="{DynamicResource FV.Brush.OkSoft}" />
                    <Setter TargetName="txt" Property="Foreground" Value="{DynamicResource FV.Brush.Ok}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Converter={StaticResource PingState}}" Value="warn">
                    <Setter TargetName="pill" Property="Background" Value="{DynamicResource FV.Brush.WarnSoft}" />
                    <Setter TargetName="txt" Property="Foreground" Value="{DynamicResource FV.Brush.Warn}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Converter={StaticResource PingState}}" Value="bad">
                    <Setter TargetName="pill" Property="Background" Value="{DynamicResource FV.Brush.BadSoft}" />
                    <Setter TargetName="txt" Property="Foreground" Value="{DynamicResource FV.Brush.Bad}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Converter={StaticResource PingState}}" Value="fail">
                    <Setter TargetName="txt" Property="Foreground" Value="{DynamicResource FV.Brush.Bad}" />
                    <Setter TargetName="txt" Property="Opacity" Value="0.7" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Converter={StaticResource PingState}}" Value="testing">
                    <Setter TargetName="spin" Property="Visibility" Value="Visible" />
                    <Setter TargetName="spin" Property="IsIndeterminate" Value="True" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!--  Small caption-like metric label  -->
        <Style
            x:Key="MetricValue"
            BasedOn="{StaticResource FV.Text.BodyStrong}"
            TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="380" />
            <ColumnDefinition Width="344" />
        </Grid.ColumnDefinitions>

        <!--  ============ Servers ============  -->
        <DockPanel Grid.Column="0" Margin="24,20,12,16">
            <!--  Header: title, icon actions, primary Add  -->
            <DockPanel Margin="0,0,0,16" DockPanel.Dock="Top">
                <StackPanel
                    VerticalAlignment="Center"
                    DockPanel.Dock="Right"
                    Orientation="Horizontal">
                    <Button
                        x:Name="btnPingAll"
                        Style="{StaticResource FV.Button.Icon}"
                        ToolTip="Проверить пинг всех серверов">
                        <materialDesign:PackIcon
                            Width="20"
                            Height="20"
                            Kind="Speedometer" />
                    </Button>
                    <Button
                        x:Name="btnUpdateSubs"
                        Margin="4,0,0,0"
                        Style="{StaticResource FV.Button.Icon}"
                        ToolTip="Обновить подписки">
                        <materialDesign:PackIcon
                            Width="20"
                            Height="20"
                            Kind="Refresh" />
                    </Button>
                    <Button
                        x:Name="btnAdd"
                        Height="36"
                        Margin="12,0,0,0"
                        Padding="14,0"
                        Style="{StaticResource FV.Button.Primary}"
                        ToolTip="Скопируйте ссылку на подписку и нажмите — она добавится сама (Ctrl+V)">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon
                                Width="18"
                                Height="18"
                                VerticalAlignment="Center"
                                Kind="Plus" />
                            <TextBlock
                                Margin="6,0,0,0"
                                VerticalAlignment="Center"
                                Text="Добавить" />
                        </StackPanel>
                    </Button>
                </StackPanel>
                <TextBlock
                    VerticalAlignment="Center"
                    Style="{StaticResource FV.Text.H1}"
                    Text="Серверы" />
            </DockPanel>

            <!--  Subscription cards (click = show its servers)  -->
            <ScrollViewer
                MaxHeight="360"
                DockPanel.Dock="Top"
                VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="lstCards" ItemsSource="{Binding Cards}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border
                                x:Name="card"
                                Margin="0,0,0,12"
                                Padding="16,12"
                                Cursor="Hand"
                                MouseLeftButtonUp="Card_MouseLeftButtonUp"
                                MouseRightButtonUp="CardMenu_Click"
                                Style="{StaticResource FV.Card}">
                                <Grid>
                                    <Border
                                        x:Name="selBar"
                                        Width="3"
                                        Margin="-16,2,0,2"
                                        HorizontalAlignment="Left"
                                        Background="{DynamicResource FV.Brush.Accent}"
                                        CornerRadius="0,2,2,0"
                                        Visibility="Collapsed" />
                                    <StackPanel>
                                        <!--  Title + actions  -->
                                        <DockPanel>
                                            <StackPanel
                                                VerticalAlignment="Center"
                                                DockPanel.Dock="Right"
                                                Orientation="Horizontal">
                                                <Button
                                                    Click="CardSupport_Click"
                                                    Style="{StaticResource FV.Button.Icon}"
                                                    ToolTip="Поддержка провайдера"
                                                    Visibility="{Binding SupportUrl, Converter={StaticResource NotEmptyToVis}}">
                                                    <materialDesign:PackIcon
                                                        Width="18"
                                                        Height="18"
                                                        Kind="Send" />
                                                </Button>
                                                <Button
                                                    Click="CardPing_Click"
                                                    Style="{StaticResource FV.Button.Icon}"
                                                    ToolTip="Проверить серверы подписки">
                                                    <materialDesign:PackIcon
                                                        Width="18"
                                                        Height="18"
                                                        Kind="Speedometer" />
                                                </Button>
                                                <Button
                                                    Click="CardUpdate_Click"
                                                    Style="{StaticResource FV.Button.Icon}"
                                                    ToolTip="Обновить подписку">
                                                    <materialDesign:PackIcon
                                                        Width="18"
                                                        Height="18"
                                                        Kind="Refresh" />
                                                </Button>
                                                <Button
                                                    Click="CardMenu_Click"
                                                    Style="{StaticResource FV.Button.Icon}"
                                                    ToolTip="Ещё действия">
                                                    <materialDesign:PackIcon
                                                        Width="18"
                                                        Height="18"
                                                        Kind="DotsVertical" />
                                                </Button>
                                            </StackPanel>
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                FontSize="15"
                                                Style="{StaticResource FV.Text.BodyStrong}"
                                                Text="{Binding Title}"
                                                ToolTip="{Binding Title}" />
                                        </DockPanel>

                                        <!--  Two compact metrics  -->
                                        <Grid Margin="0,8,0,0" Visibility="{Binding HasMetrics, Converter={StaticResource BoolToVis}}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="16" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Visibility="{Binding HasTraffic, Converter={StaticResource BoolToVis}}">
                                                <DockPanel>
                                                    <TextBlock
                                                        DockPanel.Dock="Right"
                                                        Style="{StaticResource FV.Text.Caption}"
                                                        Text="{Binding TrafficDetail}" />
                                                    <TextBlock Style="{StaticResource FV.Text.Overline}" Text="ТРАФИК" />
                                                </DockPanel>
                                                <TextBlock
                                                    Margin="0,2,0,0"
                                                    Style="{StaticResource MetricValue}"
                                                    Text="{Binding TrafficValue}" />
                                                <ProgressBar
                                                    Margin="0,6,0,0"
                                                    Maximum="100"
                                                    Style="{StaticResource FV.ProgressBar}"
                                                    Visibility="{Binding HasProgress, Converter={StaticResource BoolToVis}}"
                                                    Value="{Binding Progress, Mode=OneWay}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" Visibility="{Binding HasExpire, Converter={StaticResource BoolToVis}}">
                                                <DockPanel>
                                                    <TextBlock
                                                        x:Name="expireDetail"
                                                        DockPanel.Dock="Right"
                                                        Style="{StaticResource FV.Text.Caption}"
                                                        Text="{Binding ExpireDetail}" />
                                                    <TextBlock Style="{StaticResource FV.Text.Overline}" Text="ПОДПИСКА" />
                                                </DockPanel>
                                                <TextBlock
                                                    x:Name="expireText"
                                                    Margin="0,2,0,0"
                                                    Style="{StaticResource MetricValue}"
                                                    Text="{Binding ExpireText}" />
                                            </StackPanel>
                                        </Grid>

                                        <!--  Provider announcement: two lines, unfolds on demand  -->
                                        <StackPanel Margin="0,10,0,0" Visibility="{Binding Announce, Converter={StaticResource NotEmptyToVis}}">
                                            <TextBlock
                                                x:Name="announce"
                                                MaxHeight="36"
                                                FontSize="12"
                                                Foreground="{DynamicResource FV.Brush.Text2}"
                                                LineHeight="18"
                                                Text="{Binding Announce}"
                                                TextTrimming="WordEllipsis"
                                                TextWrapping="Wrap" />
                                            <ToggleButton
                                                x:Name="announceToggle"
                                                Margin="0,4,0,0"
                                                HorizontalAlignment="Left"
                                                Cursor="Hand"
                                                Visibility="{Binding AnnounceIsLong, Converter={StaticResource BoolToVis}}">
                                                <ToggleButton.Template>
                                                    <ControlTemplate TargetType="ToggleButton">
                                                        <TextBlock
                                                            x:Name="t"
                                                            FontSize="12"
                                                            FontWeight="SemiBold"
                                                            Foreground="{DynamicResource FV.Brush.Accent}"
                                                            Text="Показать полностью" />
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsChecked" Value="True">
                                                                <Setter TargetName="t" Property="Text" Value="Свернуть" />
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </ToggleButton.Template>
                                            </ToggleButton>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                    <Setter TargetName="selBar" Property="Visibility" Value="Visible" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding ExpireState}" Value="warn">
                                    <Setter TargetName="expireText" Property="Foreground" Value="{DynamicResource FV.Brush.Warn}" />
                                    <Setter TargetName="expireDetail" Property="Foreground" Value="{DynamicResource FV.Brush.Warn}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding ExpireState}" Value="bad">
                                    <Setter TargetName="expireText" Property="Foreground" Value="{DynamicResource FV.Brush.Bad}" />
                                    <Setter TargetName="expireDetail" Property="Foreground" Value="{DynamicResource FV.Brush.Bad}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsChecked, ElementName=announceToggle}" Value="True">
                                    <Setter TargetName="announce" Property="MaxHeight" Value="100000" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!--  Empty state  -->
            <StackPanel
                x:Name="panelEmpty"
                Margin="0,48,0,0"
                HorizontalAlignment="Center"
                DockPanel.Dock="Top"
                Visibility="Collapsed">
                <Border
                    Width="88"
                    Height="88"
                    Background="{DynamicResource FV.Brush.Surface2}"
                    CornerRadius="44">
                    <materialDesign:PackIcon
                        Width="40"
                        Height="40"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Foreground="{DynamicResource FV.Brush.Accent}"
                        Kind="ServerNetwork" />
                </Border>
                <TextBlock
                    Margin="0,16,0,6"
                    HorizontalAlignment="Center"
                    Style="{StaticResource FV.Text.H2}"
                    Text="Пока нет серверов" />
                <TextBlock
                    MaxWidth="360"
                    HorizontalAlignment="Center"
                    FontSize="14"
                    Foreground="{DynamicResource FV.Brush.Text2}"
                    Text="Скопируйте ссылку на подписку от провайдера (начинается с https://) и нажмите кнопку ниже — серверы загрузятся сами"
                    TextAlignment="Center"
                    TextWrapping="Wrap" />
                <Button
                    x:Name="btnEmptyPaste"
                    Margin="0,20,0,0"
                    Padding="24,0"
                    HorizontalAlignment="Center"
                    Style="{StaticResource FV.Button.Primary}">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon
                            Width="18"
                            Height="18"
                            VerticalAlignment="Center"
                            Kind="ContentPaste" />
                        <TextBlock
                            Margin="8,0,0,0"
                            VerticalAlignment="Center"
                            Text="Добавить подписку" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <!--  Server list: virtualized, no effects in rows  -->
            <ListBox
                x:Name="lstServers"
                Margin="0,4,0,0"
                HorizontalContentAlignment="Stretch"
                Background="Transparent"
                BorderThickness="0"
                ItemsSource="{Binding Profiles.ProfileItems}"
                ScrollViewer.CanContentScroll="True"
                ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                VirtualizingPanel.IsVirtualizing="True"
                VirtualizingPanel.ScrollUnit="Pixel"
                VirtualizingPanel.VirtualizationMode="Recycling">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0,0,8,6" />
                        <Setter Property="Cursor" Value="Hand" />
                        <Setter Property="FocusVisualStyle" Value="{StaticResource FV.FocusVisual}" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <ContentPresenter />
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border
                            x:Name="row"
                            Height="64"
                            Padding="14,0,10,0"
                            Background="{DynamicResource FV.Brush.Surface}"
                            BorderBrush="{DynamicResource FV.Brush.Border}"
                            BorderThickness="1"
                            CornerRadius="12"
                            MouseLeftButtonUp="Server_MouseLeftButtonUp">
                            <Border.ContextMenu>
                                <ContextMenu Style="{StaticResource FV.ContextMenu}">
                                    <MenuItem Click="ServerConnect_Click" Header="Выбрать сервер" />
                                    <MenuItem Click="ServerFavorite_Click" Header="В избранное / убрать" />
                                    <MenuItem Click="ServerEdit_Click" Header="Изменить" />
                                    <MenuItem Click="ServerShare_Click" Header="Скопировать ссылку" />
                                    <Separator />
                                    <MenuItem Click="ServerDelete_Click" Header="Удалить" />
                                </ContextMenu>
                            </Border.ContextMenu>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <!--  Selected server: accent bar on the left, not a white frame  -->
                                <Border
                                    x:Name="activeBar"
                                    Width="3"
                                    Height="28"
                                    Margin="-14,0,0,0"
                                    HorizontalAlignment="Left"
                                    Background="{DynamicResource FV.Brush.Accent}"
                                    CornerRadius="0,2,2,0"
                                    Visibility="Collapsed" />
                                <ContentPresenter
                                    Grid.Column="0"
                                    VerticalAlignment="Center"
                                    Content="{Binding Remarks, Converter={StaticResource ProfileCode}}"
                                    ContentTemplate="{StaticResource Flag}" />
                                <StackPanel
                                    Grid.Column="1"
                                    Margin="12,0,8,0"
                                    VerticalAlignment="Center">
                                    <TextBlock
                                        Style="{StaticResource FV.Text.BodyStrong}"
                                        Text="{Binding Remarks, Converter={StaticResource ProfileName}}"
                                        ToolTip="{Binding Remarks, Converter={StaticResource DisplayText}}" />
                                    <ItemsControl
                                        Margin="0,4,0,0"
                                        Focusable="False"
                                        IsTabStop="False"
                                        ItemTemplate="{StaticResource FV.ChipTemplate}"
                                        ItemsPanel="{StaticResource FV.ChipPanel}"
                                        ItemsSource="{Binding Converter={StaticResource ProfileChips}}" />
                                </StackPanel>
                                <Button
                                    x:Name="star"
                                    Grid.Column="2"
                                    Width="32"
                                    Height="32"
                                    Click="ServerFavorite_Click"
                                    Opacity="0"
                                    Style="{StaticResource FV.Button.Icon}"
                                    ToolTip="Избранное">
                                    <materialDesign:PackIcon
                                        x:Name="starIcon"
                                        Width="18"
                                        Height="18"
                                        Kind="StarOutline" />
                                </Button>
                                <ContentPresenter
                                    Grid.Column="3"
                                    Margin="6,0"
                                    VerticalAlignment="Center"
                                    Content="{Binding DelayVal}"
                                    ContentTemplate="{StaticResource PingPill}" />
                                <Button
                                    x:Name="more"
                                    Grid.Column="4"
                                    Width="32"
                                    Height="32"
                                    Click="ServerMore_Click"
                                    Opacity="0"
                                    Style="{StaticResource FV.Button.Icon}"
                                    ToolTip="Ещё действия">
                                    <materialDesign:PackIcon
                                        Width="18"
                                        Height="18"
                                        Kind="DotsVertical" />
                                </Button>
                            </Grid>
                        </Border>
                        <DataTemplate.Triggers>
                            <Trigger SourceName="row" Property="IsMouseOver" Value="True">
                                <Setter TargetName="row" Property="Background" Value="{DynamicResource FV.Brush.Surface2}" />
                                <Setter TargetName="star" Property="Opacity" Value="1" />
                                <Setter TargetName="more" Property="Opacity" Value="1" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                                <Setter TargetName="star" Property="Opacity" Value="1" />
                                <Setter TargetName="starIcon" Property="Kind" Value="Star" />
                                <Setter TargetName="starIcon" Property="Foreground" Value="{DynamicResource FV.Brush.Warn}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                <Setter TargetName="activeBar" Property="Visibility" Value="Visible" />
                                <Setter TargetName="row" Property="Background" Value="{DynamicResource FV.Brush.Surface2}" />
                                <Setter TargetName="row" Property="BorderBrush" Value="{DynamicResource FV.Brush.AccentSoft}" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <!--  ============ Connect pane ============  -->
        <Border
            Grid.Column="1"
            Margin="12,20,24,16"
            Padding="20"
            Effect="{StaticResource FV.Shadow.Card}"
            Style="{StaticResource FV.Card}">
            <Grid>
                <Grid.RowDefinitions>
                    <!--  The status block takes the free height and stays centred: no empty gap  -->
                    <RowDefinition Height="*" MinHeight="180" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!--  Status: shrinks as a whole on short windows instead of clipping  -->
                <Viewbox
                    Grid.Row="0"
                    VerticalAlignment="Center"
                    Stretch="Uniform"
                    StretchDirection="DownOnly">
                    <StackPanel Width="260">
                        <Button
                            x:Name="btnPower"
                            Width="168"
                            Height="168"
                            HorizontalAlignment="Center"
                            Cursor="Hand"
                            FocusVisualStyle="{StaticResource FV.FocusVisual}"
                            ToolTip="Подключить / отключить">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Grid x:Name="root" RenderTransformOrigin="0.5,0.5">
                                        <Grid.RenderTransform>
                                            <TransformGroup>
                                                <ScaleTransform x:Name="press" ScaleX="1" ScaleY="1" />
                                                <TranslateTransform x:Name="shake" X="0" />
                                            </TransformGroup>
                                        </Grid.RenderTransform>
                                        <!--  Glow + fill (connected)  -->
                                        <Ellipse
                                            x:Name="fill"
                                            Margin="10"
                                            Fill="{DynamicResource FV.Brush.Accent}"
                                            Opacity="0">
                                            <Ellipse.Effect>
                                                <DropShadowEffect
                                                    BlurRadius="36"
                                                    Opacity="0.55"
                                                    RenderingBias="Performance"
                                                    ShadowDepth="0"
                                                    Color="{DynamicResource FV.Color.Accent}" />
                                            </Ellipse.Effect>
                                        </Ellipse>
                                        <!--  Neutral ring  -->
                                        <Ellipse
                                            x:Name="ring"
                                            Margin="4"
                                            Stroke="{DynamicResource FV.Brush.Border}"
                                            StrokeThickness="6" />
                                        <Ellipse
                                            x:Name="hover"
                                            Margin="10"
                                            Fill="{DynamicResource FV.Brush.Overlay}"
                                            Opacity="0" />
                                        <!--  Spinning arc (connecting)  -->
                                        <Ellipse
                                            x:Name="arc"
                                            Margin="4"
                                            Opacity="0"
                                            RenderTransformOrigin="0.5,0.5"
                                            Stroke="{DynamicResource FV.Brush.Accent}"
                                            StrokeDashArray="20 200"
                                            StrokeDashCap="Round"
                                            StrokeThickness="6">
                                            <Ellipse.RenderTransform>
                                                <RotateTransform x:Name="arcRotate" Angle="0" />
                                            </Ellipse.RenderTransform>
                                        </Ellipse>
                                        <materialDesign:PackIcon
                                            x:Name="icon"
                                            Width="56"
                                            Height="56"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Foreground="{DynamicResource FV.Brush.Text2}"
                                            Kind="Power" />
                                    </Grid>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="hover" Property="Opacity" Value="0.05" />
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Trigger.EnterActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetName="press" Storyboard.TargetProperty="ScaleX" To="0.96" Duration="0:0:0.08" />
                                                        <DoubleAnimation Storyboard.TargetName="press" Storyboard.TargetProperty="ScaleY" To="0.96" Duration="0:0:0.08" />
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </Trigger.EnterActions>
                                            <Trigger.ExitActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetName="press" Storyboard.TargetProperty="ScaleX" To="1" Duration="{x:Static common:FvMotion.Fast}" />
                                                        <DoubleAnimation Storyboard.TargetName="press" Storyboard.TargetProperty="ScaleY" To="1" Duration="{x:Static common:FvMotion.Fast}" />
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </Trigger.ExitActions>
                                        </Trigger>
                                        <DataTrigger Binding="{Binding PowerState}" Value="Connecting">
                                            <Setter TargetName="arc" Property="Opacity" Value="1" />
                                            <Setter TargetName="icon" Property="Foreground" Value="{DynamicResource FV.Brush.Accent}" />
                                            <DataTrigger.EnterActions>
                                                <BeginStoryboard x:Name="spinSb">
                                                    <Storyboard>
                                                        <DoubleAnimation
                                                            RepeatBehavior="{x:Static common:FvMotion.SpinRepeat}"
                                                            Storyboard.TargetName="arcRotate"
                                                            Storyboard.TargetProperty="Angle"
                                                            From="0"
                                                            To="360"
                                                            Duration="{x:Static common:FvMotion.Spin}" />
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </DataTrigger.EnterActions>
                                            <DataTrigger.ExitActions>
                                                <StopStoryboard BeginStoryboardName="spinSb" />
                                            </DataTrigger.ExitActions>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding PowerState}" Value="On">
                                            <Setter TargetName="icon" Property="Foreground" Value="{DynamicResource FV.Brush.OnAccent}" />
                                            <Setter TargetName="ring" Property="Stroke" Value="{DynamicResource FV.Brush.AccentSoft}" />
                                            <DataTrigger.EnterActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation
                                                            Storyboard.TargetName="fill"
                                                            Storyboard.TargetProperty="Opacity"
                                                            To="1"
                                                            Duration="{x:Static common:FvMotion.Normal}" />
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </DataTrigger.EnterActions>
                                            <DataTrigger.ExitActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation
                                                            Storyboard.TargetName="fill"
                                                            Storyboard.TargetProperty="Opacity"
                                                            To="0"
                                                            Duration="{x:Static common:FvMotion.Normal}" />
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </DataTrigger.ExitActions>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding PowerState}" Value="Error">
                                            <Setter TargetName="ring" Property="Stroke" Value="{DynamicResource FV.Brush.Bad}" />
                                            <Setter TargetName="icon" Property="Foreground" Value="{DynamicResource FV.Brush.Bad}" />
                                            <DataTrigger.EnterActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="shake" Storyboard.TargetProperty="X">
                                                            <LinearDoubleKeyFrame KeyTime="0:0:0" Value="0" />
                                                            <LinearDoubleKeyFrame KeyTime="0:0:0.06" Value="-8" />
                                                            <LinearDoubleKeyFrame KeyTime="0:0:0.12" Value="8" />
                                                            <LinearDoubleKeyFrame KeyTime="0:0:0.18" Value="-6" />
                                                            <LinearDoubleKeyFrame KeyTime="0:0:0.24" Value="6" />
                                                            <LinearDoubleKeyFrame KeyTime="0:0:0.30" Value="-3" />
                                                            <LinearDoubleKeyFrame KeyTime="0:0:0.36" Value="0" />
                                                        </DoubleAnimationUsingKeyFrames>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </DataTrigger.EnterActions>
                                        </DataTrigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <TextBlock
                            x:Name="txtStatus"
                            Margin="0,20,0,0"
                            HorizontalAlignment="Center"
                            Style="{StaticResource FV.Text.H2}"
                            Text="{Binding StatusText}" />
                        <TextBlock
                            Margin="0,4,0,0"
                            HorizontalAlignment="Center"
                            Style="{StaticResource FV.Text.Mono}"
                            Text="{Binding TimerText}" />
                        <!--  Live speed (only when the core reports it)  -->
                        <StackPanel
                            Margin="0,8,0,0"
                            HorizontalAlignment="Center"
                            Orientation="Horizontal"
                            Visibility="{Binding HasSpeed, Converter={StaticResource BoolToVis}}">
                            <materialDesign:PackIcon
                                Width="14"
                                Height="14"
                                VerticalAlignment="Center"
                                Foreground="{DynamicResource FV.Brush.Ok}"
                                Kind="ArrowDown" />
                            <TextBlock
                                Margin="4,0,16,0"
                                FontFamily="{StaticResource FV.Font.Mono}"
                                Style="{StaticResource FV.Text.Caption}"
                                Text="{Binding SpeedDownText}" />
                            <materialDesign:PackIcon
                                Width="14"
                                Height="14"
                                VerticalAlignment="Center"
                                Foreground="{DynamicResource FV.Brush.Accent}"
                                Kind="ArrowUp" />
                            <TextBlock
                                Margin="4,0,0,0"
                                FontFamily="{StaticResource FV.Font.Mono}"
                                Style="{StaticResource FV.Text.Caption}"
                                Text="{Binding SpeedUpText}" />
                        </StackPanel>
                        <TextBlock
                            Margin="0,8,0,0"
                            HorizontalAlignment="Center"
                            Style="{StaticResource FV.Text.Caption}"
                            Text="{Binding HintText}"
                            TextAlignment="Center"
                            TextWrapping="Wrap"
                            Visibility="{Binding HintText, Converter={StaticResource NotEmptyToVis}}" />
                    </StackPanel>
                </Viewbox>

                <!--  Mode  -->
                <StackPanel Grid.Row="1" Margin="0,16,0,0">
                    <TextBlock
                        Margin="2,0,0,8"
                        Style="{StaticResource FV.Text.Overline}"
                        Text="РЕЖИМ" />
                    <Border Style="{StaticResource FV.Segmented}">
                        <UniformGrid Columns="3">
                            <RadioButton
                                Content="Прокси"
                                GroupName="fvMode"
                                IsChecked="{Binding IsModeProxy, Mode=TwoWay}"
                                Style="{StaticResource FV.Segment}"
                                ToolTip="Системный прокси: браузеры и большинство программ" />
                            <RadioButton
                                Content="TUN"
                                GroupName="fvMode"
                                IsChecked="{Binding IsModeTun, Mode=TwoWay}"
                                Style="{StaticResource FV.Segment}"
                                ToolTip="Весь трафик компьютера. Права администратора Windows спросят один раз" />
                            <RadioButton
                                Content="Локально"
                                GroupName="fvMode"
                                IsChecked="{Binding IsModeLocal, Mode=TwoWay}"
                                Style="{StaticResource FV.Segment}"
                                ToolTip="Только локальный порт, без изменения настроек Windows" />
                        </UniformGrid>
                    </Border>
                    <DockPanel Margin="2,8,0,0">
                        <Button
                            x:Name="btnMode"
                            Margin="8,-6,0,-6"
                            DockPanel.Dock="Right"
                            Style="{StaticResource FV.Button.Ghost}"
                            ToolTip="Движок режима TUN"
                            Visibility="{Binding IsModeTun, Converter={StaticResource BoolToVis}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock VerticalAlignment="Center" Text="{Binding TunEngineTitle}" />
                                <materialDesign:PackIcon
                                    Width="14"
                                    Height="14"
                                    Margin="2,0,0,0"
                                    VerticalAlignment="Center"
                                    Kind="ChevronDown" />
                            </StackPanel>
                        </Button>
                        <TextBlock
                            Style="{StaticResource FV.Text.Caption}"
                            Text="{Binding ModeHint}"
                            TextWrapping="Wrap" />
                    </DockPanel>
                </StackPanel>

                <!--  Selected server  -->
                <Border
                    Grid.Row="2"
                    Margin="0,16,0,0"
                    Padding="12,10"
                    Background="{DynamicResource FV.Brush.Surface2}"
                    CornerRadius="12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ContentPresenter
                            VerticalAlignment="Center"
                            Content="{Binding ServerCode}"
                            ContentTemplate="{StaticResource Flag}" />
                        <StackPanel
                            Grid.Column="1"
                            Margin="10,0,8,0"
                            VerticalAlignment="Center">
                            <TextBlock
                                Style="{StaticResource FV.Text.BodyStrong}"
                                Text="{Binding ServerName}"
                                ToolTip="{Binding ServerName}" />
                            <ItemsControl
                                Margin="0,4,0,0"
                                Focusable="False"
                                IsTabStop="False"
                                ItemTemplate="{StaticResource FV.ChipTemplate}"
                                ItemsPanel="{StaticResource FV.ChipPanel}"
                                ItemsSource="{Binding ActiveServer, Converter={StaticResource ProfileChips}}" />
                        </StackPanel>
                        <ContentPresenter
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            Content="{Binding ActiveServer.DelayVal}"
                            ContentTemplate="{StaticResource PingPill}" />
                    </Grid>
                </Border>

                <!--  Actions  -->
                <StackPanel Grid.Row="3" Margin="0,16,0,0">
                    <Button
                        x:Name="btnConnectBest"
                        HorizontalAlignment="Stretch"
                        Style="{StaticResource FV.Button.Primary}"
                        ToolTip="Проверить серверы подписки и подключиться к самому быстрому">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon
                                Width="18"
                                Height="18"
                                VerticalAlignment="Center"
                                Kind="LightningBolt" />
                            <TextBlock
                                Margin="8,0,0,0"
                                VerticalAlignment="Center"
                                Text="Подключиться к лучшему" />
                        </StackPanel>
                    </Button>
                    <StackPanel
                        Margin="0,8,0,0"
                        HorizontalAlignment="Center"
                        Orientation="Horizontal"
                        Visibility="{Binding BestLine, Converter={StaticResource NotEmptyToVis}}">
                        <TextBlock
                            Margin="0,0,6,0"
                            VerticalAlignment="Center"
                            Style="{StaticResource FV.Text.Caption}"
                            Text="Лучший:" />
                        <ContentPresenter
                            Margin="0,0,6,0"
                            VerticalAlignment="Center"
                            Content="{Binding BestCode}"
                            ContentTemplate="{StaticResource Flag}">
                            <ContentPresenter.LayoutTransform>
                                <ScaleTransform ScaleX="0.67" ScaleY="0.67" />
                            </ContentPresenter.LayoutTransform>
                        </ContentPresenter>
                        <TextBlock
                            MaxWidth="220"
                            VerticalAlignment="Center"
                            Style="{StaticResource FV.Text.Caption}"
                            Text="{Binding BestLine}"
                            ToolTip="{Binding BestLine}" />
                    </StackPanel>
                    <DockPanel Margin="0,8,0,0">
                        <Button
                            x:Name="btnTestPing"
                            DockPanel.Dock="Right"
                            Style="{StaticResource FV.Button.Ghost}"
                            ToolTip="Один реальный запрос через выбранный сервер">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon
                                    Width="14"
                                    Height="14"
                                    VerticalAlignment="Center"
                                    Kind="Pulse" />
                                <TextBlock
                                    Margin="6,0,0,0"
                                    VerticalAlignment="Center"
                                    Text="Проверить" />
                            </StackPanel>
                        </Button>
                        <TextBlock
                            VerticalAlignment="Center"
                            Style="{StaticResource FV.Text.Caption}"
                            Text="{Binding PingText}"
                            ToolTip="{Binding PingText}" />
                    </DockPanel>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
