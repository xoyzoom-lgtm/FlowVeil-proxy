<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:common="clr-namespace:v2rayN.Common"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:system="clr-namespace:System;assembly=mscorlib">

    <!--
        FlowVeil design system. Colours are DynamicResource tokens that FlowVeilPalette
        recomputes from the active colour theme; the values below are only the first-frame
        defaults (dark). Grid: 8 px. Radii: cards 16, controls 12, pills 999.
    -->

    <!--  ===== Colour tokens (defaults) =====  -->
    <SolidColorBrush x:Key="FV.Brush.Window" Color="#0B0C10" />
    <SolidColorBrush x:Key="FV.Brush.Surface" Color="#14161C" />
    <SolidColorBrush x:Key="FV.Brush.Surface2" Color="#1B1E26" />
    <SolidColorBrush x:Key="FV.Brush.Border" Color="#262A33" />
    <SolidColorBrush x:Key="FV.Brush.Text" Color="#F2F4F8" />
    <SolidColorBrush x:Key="FV.Brush.Text2" Color="#9AA3B2" />
    <SolidColorBrush x:Key="FV.Brush.Text3" Color="#6B7280" />
    <SolidColorBrush x:Key="FV.Brush.Accent" Color="#3B82F6" />
    <SolidColorBrush x:Key="FV.Brush.OnAccent" Color="#FFFFFF" />
    <SolidColorBrush x:Key="FV.Brush.AccentSoft" Color="#2E3B82F6" />
    <SolidColorBrush x:Key="FV.Brush.Overlay" Color="#FFFFFF" />
    <Color x:Key="FV.Color.Accent">#3B82F6</Color>

    <!--  Status colours are fixed on purpose: they mean the same in every theme  -->
    <SolidColorBrush x:Key="FV.Brush.Ok" Color="#34D399" />
    <SolidColorBrush x:Key="FV.Brush.Warn" Color="#FBBF24" />
    <SolidColorBrush x:Key="FV.Brush.Bad" Color="#F87171" />
    <SolidColorBrush x:Key="FV.Brush.OkSoft" Color="#2634D399" />
    <SolidColorBrush x:Key="FV.Brush.WarnSoft" Color="#26FBBF24" />
    <SolidColorBrush x:Key="FV.Brush.BadSoft" Color="#26F87171" />
    <Color x:Key="FV.Color.Bad">#F87171</Color>

    <!--  ===== Typography =====  -->
    <FontFamily x:Key="FV.Font.Ui">Segoe UI Variable Text, Segoe UI, Segoe UI Emoji, Segoe UI Symbol</FontFamily>
    <FontFamily x:Key="FV.Font.Display">Segoe UI Variable Display, Segoe UI, Segoe UI Emoji</FontFamily>
    <FontFamily x:Key="FV.Font.Mono">Cascadia Mono, Consolas</FontFamily>

    <Style x:Key="FV.Text.H1" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FV.Font.Display}" />
        <Setter Property="FontSize" Value="28" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource FV.Brush.Text}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style x:Key="FV.Text.H2" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FV.Font.Display}" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource FV.Brush.Text}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style x:Key="FV.Text.Body" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{DynamicResource FV.Brush.Text}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style x:Key="FV.Text.BodyStrong" BasedOn="{StaticResource FV.Text.Body}" TargetType="TextBlock">
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style x:Key="FV.Text.Caption" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource FV.Brush.Text2}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style x:Key="FV.Text.Overline" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource FV.Brush.Text3}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style x:Key="FV.Text.Mono" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FV.Font.Mono}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="Foreground" Value="{DynamicResource FV.Brush.Text2}" />
    </Style>

    <!--  ===== Focus ring (keyboard only) =====  -->
    <Style x:Key="FV.FocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border
                        Margin="-3"
                        BorderBrush="{DynamicResource FV.Brush.Accent}"
                        BorderThickness="2"
                        CornerRadius="14"
                        SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  ===== Card =====  -->
    <!--  Shared soft shadow for the few big cards (never on list rows)  -->
    <DropShadowEffect
        x:Key="FV.Shadow.Card"
        BlurRadius="24"
        Direction="270"
        Opacity="0.22"
        RenderingBias="Performance"
        ShadowDepth="4"
        Color="Black" />

    <Style x:Key="FV.Card" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource FV.Brush.Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource FV.Brush.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="Padding" Value="16" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!--  ===== Buttons =====  -->
    <Style x:Key="FV.Button.Base" TargetType="ButtonBase">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Height" Value="44" />
        <Setter Property="Padding" Value="16,0" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FV.FocusVisual}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ButtonBase">
                    <Grid>
                        <Border
                            x:Name="bg"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="12" />
                        <Border
                            x:Name="hover"
                            Background="{DynamicResource FV.Brush.Overlay}"
                            CornerRadius="12"
                            IsHitTestVisible="False"
                            Opacity="0" />
                        <Border
                            x:Name="press"
                            Background="Black"
                            CornerRadius="12"
                            IsHitTestVisible="False"
                            Opacity="0" />
                        <ContentPresenter
                            Margin="{TemplateBinding Padding}"
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                            RecognizesAccessKey="True" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation
                                            Storyboard.TargetName="hover"
                                            Storyboard.TargetProperty="Opacity"
                                            To="0.10"
                                            Duration="{x:Static common:FvMotion.Fast}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation
                                            Storyboard.TargetName="hover"
                                            Storyboard.TargetProperty="Opacity"
                                            To="0"
                                            Duration="{x:Static common:FvMotion.Fast}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="press" Property="Opacity" Value="0.14" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style
        x:Key="FV.Button.Primary"
        BasedOn="{StaticResource FV.Button.Base}"
        TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource FV.Brush.Accent}" />
        <Setter Property="Foreground" Value="{DynamicResource FV.Brush.OnAccent}" />
    </Style>

    <Style
        x:Key="FV.Button.Secondary"
        BasedOn="{StaticResource FV.Button.Base}"
        TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource FV.Brush.Surface2}" />
        <Setter Property="Foreground" Value="{DynamicResource FV.Brush.Text}" />
        <Setter Property="BorderBrush" Value="{DynamicResource FV.Brush.Border}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <Style
        x:Key="FV.Button.Ghost"
        BasedOn="{StaticResource FV.Button.Base}"
        TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource FV.Brush.Text2}" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <!--  Square icon action. Every use must set a ToolTip.  -->
    <Style
        x:Key="FV.Button.Icon"
        BasedOn="{StaticResource FV.Button.Base}"
        TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource FV.Brush.Text2}" />
        <Setter Property="Width" Value="36" />
        <Setter Property="Height" Value="36" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <!--  ===== Chips and pills =====  -->
    <Style x:Key="FV.Chip" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource FV.Brush.Surface2}" />
        <Setter Property="CornerRadius" Value="999" />
        <Setter Property="Padding" Value="8,1,8,2" />
        <Setter Property="Margin" Value="0,0,4,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="FV.Chip.Text" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource FV.Brush.Text2}" />
    </Style>

    <DataTemplate x:Key="FV.ChipTemplate">
        <Border Style="{StaticResource FV.Chip}">
            <TextBlock Style="{StaticResource FV.Chip.Text}" Text="{Binding}" />
        </Border>
    </DataTemplate>

    <ItemsPanelTemplate x:Key="FV.ChipPanel">
        <StackPanel Orientation="Horizontal" />
    </ItemsPanelTemplate>

    <!--  ===== Progress bar: thin and rounded =====  -->
    <Style x:Key="FV.ProgressBar" TargetType="ProgressBar">
        <Setter Property="Height" Value="4" />
        <Setter Property="Foreground" Value="{DynamicResource FV.Brush.Accent}" />
        <Setter Property="Background" Value="{DynamicResource FV.Brush.Surface2}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Grid SnapsToDevicePixels="True">
                        <Border
                            x:Name="PART_Track"
                            Background="{TemplateBinding Background}"
                            CornerRadius="2" />
                        <Border
                            x:Name="PART_Indicator"
                            HorizontalAlignment="Left"
                            Background="{TemplateBinding Foreground}"
                            CornerRadius="2" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  ===== Thin scrollbar, no arrows; fades in on hover =====  -->
    <Style x:Key="FV.ScrollBar.Page" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="Transparent" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="FV.ScrollBar.Thumb" TargetType="Thumb">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border Background="{DynamicResource FV.Brush.Text3}" CornerRadius="3" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="FV.ScrollBar" TargetType="ScrollBar">
        <Setter Property="Stylus.IsFlicksEnabled" Value="False" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Width" Value="10" />
        <Setter Property="MinWidth" Value="10" />
        <Setter Property="Opacity" Value="0.55" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Track
                        x:Name="PART_Track"
                        Margin="2"
                        IsDirectionReversed="True">
                        <Track.DecreaseRepeatButton>
                            <RepeatButton Command="ScrollBar.PageUpCommand" Style="{StaticResource FV.ScrollBar.Page}" />
                        </Track.DecreaseRepeatButton>
                        <Track.Thumb>
                            <Thumb Style="{StaticResource FV.ScrollBar.Thumb}" />
                        </Track.Thumb>
                        <Track.IncreaseRepeatButton>
                            <RepeatButton Command="ScrollBar.PageDownCommand" Style="{StaticResource FV.ScrollBar.Page}" />
                        </Track.IncreaseRepeatButton>
                    </Track>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Opacity" Value="1" />
            </Trigger>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="Height" Value="10" />
                <Setter Property="MinHeight" Value="10" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Track x:Name="PART_Track" Margin="2">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageLeftCommand" Style="{StaticResource FV.ScrollBar.Page}" />
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource FV.ScrollBar.Thumb}" />
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageRightCommand" Style="{StaticResource FV.ScrollBar.Page}" />
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!--  ===== Toggle switch =====  -->
    <Style x:Key="FV.Toggle" TargetType="ToggleButton">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Width" Value="40" />
        <Setter Property="Height" Value="22" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FV.FocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid>
                        <Border
                            x:Name="track"
                            Background="{DynamicResource FV.Brush.Surface2}"
                            BorderBrush="{DynamicResource FV.Brush.Border}"
                            BorderThickness="1"
                            CornerRadius="11" />
                        <Border
                            x:Name="trackOn"
                            Background="{DynamicResource FV.Brush.Accent}"
                            CornerRadius="11"
                            Opacity="0" />
                        <Ellipse
                            x:Name="knob"
                            Width="16"
                            Height="16"
                            Margin="3,0"
                            HorizontalAlignment="Left"
                            Fill="{DynamicResource FV.Brush.Text2}">
                            <Ellipse.RenderTransform>
                                <TranslateTransform x:Name="knobShift" X="0" />
                            </Ellipse.RenderTransform>
                        </Ellipse>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation
                                            Storyboard.TargetName="knobShift"
                                            Storyboard.TargetProperty="X"
                                            To="18"
                                            Duration="{x:Static common:FvMotion.Fast}" />
                                        <DoubleAnimation
                                            Storyboard.TargetName="trackOn"
                                            Storyboard.TargetProperty="Opacity"
                                            To="1"
                                            Duration="{x:Static common:FvMotion.Fast}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation
                                            Storyboard.TargetName="knobShift"
                                            Storyboard.TargetProperty="X"
                                            To="0"
                                            Duration="{x:Static common:FvMotion.Fast}" />
                                        <DoubleAnimation
                                            Storyboard.TargetName="trackOn"
                                            Storyboard.TargetProperty="Opacity"
                                            To="0"
                                            Duration="{x:Static common:FvMotion.Fast}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                            <Setter TargetName="knob" Property="Fill" Value="{DynamicResource FV.Brush.OnAccent}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  ===== Segmented control: RadioButtons inside FV.Segmented =====  -->
    <Style x:Key="FV.Segmented" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource FV.Brush.Surface2}" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="3" />
    </Style>
    <Style x:Key="FV.Segment" TargetType="RadioButton">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Height" Value="34" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource FV.Brush.Text2}" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FV.FocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid>
                        <Border
                            x:Name="sel"
                            Background="{DynamicResource FV.Brush.AccentSoft}"
                            CornerRadius="9"
                            Opacity="0" />
                        <Border
                            x:Name="hover"
                            Background="{DynamicResource FV.Brush.Overlay}"
                            CornerRadius="9"
                            Opacity="0" />
                        <ContentPresenter
                            Margin="8,0"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="hover" Property="Opacity" Value="0.06" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation
                                            Storyboard.TargetName="sel"
                                            Storyboard.TargetProperty="Opacity"
                                            To="1"
                                            Duration="{x:Static common:FvMotion.Fast}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation
                                            Storyboard.TargetName="sel"
                                            Storyboard.TargetProperty="Opacity"
                                            To="0"
                                            Duration="{x:Static common:FvMotion.Fast}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                            <Setter Property="Foreground" Value="{DynamicResource FV.Brush.Accent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  ===== Tooltip (app-wide) =====  -->
    <Style TargetType="ToolTip">
        <Setter Property="Background" Value="{DynamicResource FV.Brush.Surface2}" />
        <Setter Property="Foreground" Value="{DynamicResource FV.Brush.Text}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="HasDropShadow" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border
                        MaxWidth="360"
                        Margin="4"
                        Padding="{TemplateBinding Padding}"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{DynamicResource FV.Brush.Border}"
                        BorderThickness="1"
                        CornerRadius="8">
                        <ContentPresenter>
                            <ContentPresenter.Resources>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextWrapping" Value="Wrap" />
                                </Style>
                            </ContentPresenter.Resources>
                        </ContentPresenter>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  ===== Context menus: rounded surface with a soft shadow (tray uses the same) =====  -->
    <Style x:Key="FV.ContextMenu" TargetType="ContextMenu">
        <Setter Property="HasDropShadow" Value="False" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource FV.Brush.Text}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Border
                        Margin="10"
                        Padding="6"
                        Background="{DynamicResource FV.Brush.Surface}"
                        BorderBrush="{DynamicResource FV.Brush.Border}"
                        BorderThickness="1"
                        CornerRadius="14">
                        <Border.Effect>
                            <DropShadowEffect
                                BlurRadius="18"
                                Opacity="0.35"
                                RenderingBias="Performance"
                                ShadowDepth="3" />
                        </Border.Effect>
                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
